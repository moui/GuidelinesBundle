{% embed '@theme/embeds/card.html.twig' with {'border': false, 'margin_bottom': 0} %}
    {% block box_title %}{{ title|trans }}{% endblock %}
    {% block box_body %}
        {% if data.content is empty %}
            <div class="text-secondary">
                {{ 'guidelines.widget.empty'|trans }}
                {% if is_granted('guidelines_edit') %}
                    <a href="{{ path('guidelines_settings') }}">{{ 'guidelines.widget.write'|trans }}</a>
                {% endif %}
            </div>
        {% else %}
            {{ include('@Guidelines/_compact.html.twig') }}
            <div class="markdown guidelines-md" style="max-height: 28rem; overflow-y: auto;">
                {{ data.content|md2html }}
            </div>
        {% endif %}
    {% endblock %}
    {#- Whitespace control matters: the card renders a footer for any non-empty block. -#}
    {% block box_footer -%}
        {%- if data.content is not empty and (data.updated_at is not null or is_granted('guidelines_edit')) %}
            <div class="d-flex justify-content-between small text-secondary">
                <span>
                    {% if data.updated_at is not null %}
                        {% if data.updated_by is not empty %}
                            {{ 'guidelines.widget.updated_at_by'|trans({'%date%': data.updated_at|date_short, '%user%': data.updated_by}) }}
                        {% else %}
                            {{ 'guidelines.widget.updated_at'|trans({'%date%': data.updated_at|date_short}) }}
                        {% endif %}
                    {% endif %}
                </span>
                {% if is_granted('guidelines_edit') %}
                    <a href="{{ path('guidelines_settings') }}">{{ 'edit'|trans }}</a>
                {% endif %}
            </div>
        {% endif -%}
    {%- endblock %}
{% endembed %}
